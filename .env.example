# ---- General -------------------------------------------------------------
APP_ENV=local                # local | staging | production
LOG_LEVEL=INFO
DEMO_MODE=true               # exposes /api/demo/* (simulate shoppers, reset). Set false in production.
CORS_ORIGINS=http://localhost:5173
OPS_API_KEY=                 # when set, owner endpoints require header X-API-Key. ALWAYS set outside local dev.

# ---- Gemini / Google AI (pick ONE auth path) ------------------------------
LLM_MODE=auto                # auto = use Gemini when credentials exist; off = built-in engine only
GEMINI_MODEL=gemini-2.5-flash
# A) Vertex AI with Application Default Credentials (recommended; what Cloud Run uses)
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# B) Gemini API key (local development)
GOOGLE_API_KEY=

# ---- Data -----------------------------------------------------------------
STORE_BACKEND=memory         # memory | firestore
FIRESTORE_DATABASE=(default)
BIGQUERY_DATASET=            # stream demand events to BigQuery and/or read sales from it (e.g. shelfsense)
SALES_BACKEND=memory         # memory (synthetic demo history) | bigquery (<dataset>.sales_daily)
SEED_ON_START=true           # load the synthetic demo store when empty. Keep false for real data.
SESSION_DB_URL=              # optional ADK DatabaseSessionService URL; default is in-memory sessions

# ---- Inventory policy (all visible in the owner UI rationale text) --------
SERVICE_LEVEL_Z=1.65         # 95% cycle service level
REVIEW_PERIOD_DAYS=7
CAPTURE_RATE=0.5             # share of turned-away shoppers assumed to buy
ASSISTANT_REACH=0.3          # share of all shoppers the assistant sees (scales observed demand)

# ---- Notifications --------------------------------------------------------
NOTIFY_WEBHOOK_URL=          # optional: POST each notification (WhatsApp/SMS bridge)
